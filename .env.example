# Local development only. Use a dedicated database and strong credentials.
DATABASE_URL=postgresql://opspilot:replace-with-a-local-password@127.0.0.1:5432/opspilot
POSTGRES_PASSWORD=replace-with-a-strong-url-safe-password
PORT=3000
# false only for local HTTP. Set true when serving through HTTPS.
COOKIE_SECURE=false
# External AI is opt-in. Core business features work with this disabled.
AI_ENABLED=false
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
# Test against a disposable instance/database, never real customer data.
TEST_BASE_URL=http://localhost:3000
