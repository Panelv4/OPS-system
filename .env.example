# Local development only. Use a dedicated database and strong credentials.
DATABASE_URL=postgresql://opspilot:replace-with-a-local-password@127.0.0.1:5432/opspilot
POSTGRES_PASSWORD=replace-with-a-strong-url-safe-password
PORT=3000
# false only for local HTTP. Set true when serving through HTTPS.
COOKIE_SECURE=false
# true only when a reverse proxy (Vercel, Cloudflare, nginx) overwrites
# X-Forwarded-For. When false, forwarded headers are ignored for rate limiting.
TRUST_PROXY=false
# External AI is opt-in. Core business features work with this disabled.
AI_ENABLED=false
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
# Billing is opt-in. Leave BILLING_PROVIDER unset to disable payments entirely:
# every workspace resolves to the free plan and checkout returns 503.
# Allowed: test (webhook-driven, no network) | stripe (adapter not wired yet).
BILLING_PROVIDER=
# Required whenever BILLING_PROVIDER is set. 16+ characters. Never reuse across environments.
BILLING_WEBHOOK_SECRET=
# Email. "console" writes messages to the server log and the delivery table
# (development, CI, and any deployment without a sending domain). Use "resend"
# once a domain is verified with the provider.
MAIL_TRANSPORT=console
MAIL_FROM=OpsPilot <no-reply@yourdomain.com>
RESEND_API_KEY=
# Absolute base URL used in email links. Must match where the app is served.
APP_URL=http://localhost:3000
# Test against a disposable instance/database, never real customer data.
TEST_BASE_URL=http://localhost:3000
